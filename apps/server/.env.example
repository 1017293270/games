# 复制为 .env 后按需修改。.env 不进仓库（根 .gitignore 已忽略）。

# 监听端口与地址。0.0.0.0 让局域网/公网的朋友能连上。
PORT=3000
HOST=0.0.0.0

# SQLite 库文件与其它运行时数据的目录。库文件是 <DATA_DIR>/game.db。
DATA_DIR=./data

# 后台密码。**必填**，缺失时进程启动即退出。
ADMIN_PASSWORD=

# 后台登录用的用户名。
ADMIN_USERNAME=admin

# 首次启动写入 invites 表的一条无限次邀请码。留空则不写入。
# world.inviteRequired 为 false 时注册不校验邀请码。
INVITE_CODE=

# 登录会话有效期（天）。
SESSION_TTL_DAYS=30

# 客户端构建产物目录，相对 apps/server 包根解析。目录存在即托管，
# 并对非 /api、非 /socket.io 的路径回退到 index.html（SPA）。
CLIENT_DIST=../client/dist

# fastify 日志级别：fatal error warn info debug trace silent
LOG_LEVEL=info

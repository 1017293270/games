{
  "name": "@xianxia/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.3",
    "@xianxia/shared": "workspace:*",
    "fastify": "5.12.3",
    "socket.io": "4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "socket.io-client": "4.8.3",
    "tsx": "4.20.6",
    "vitest": "5.0.0"
  }
}

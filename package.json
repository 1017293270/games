{
  "name": "xianxia-idle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "e2e": "pnpm --filter e2e run e2e",
    "dev": "pnpm --filter @xianxia/shared run build && pnpm -r --parallel --if-present run dev",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules/.cache",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}

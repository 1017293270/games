# Caddy —— 对外的唯一入口。
#
# {$DOMAIN} 来自 .env（compose 传进容器）：
#   DOMAIN=xianxia.example.com   → Caddy 自动申请并续期 Let's Encrypt 证书，
#                                  访问 http:// 会自动跳到 https://
#   DOMAIN=:80                   → 只开 HTTP，不申请证书。没有域名时（本地、
#                                  局域网、先跑通再说）用这个。
#
# 反代不需要为 WebSocket 做任何特殊配置：Caddy 的 reverse_proxy 默认就会
# 透传 Upgrade/Connection 头，Socket.IO 的 /socket.io/ 直接就能用。

{
	# 证书到期前的提醒邮箱。引号是必须的：留空时它会展开成 `email ""`，
	# Caddy 认这个（等于没填）；不加引号则会因为「少一个参数」而拒绝启动。
	email "{$ACME_EMAIL}"
	# 不需要 Caddy 自己的 admin API，关掉少一个监听口。
	admin off
}

{$DOMAIN::80} {
	# 文本和 JSON 压缩后再发。图片已经是 webp，Caddy 会自己跳过。
	encode zstd gzip

	log {
		output stdout
		format console
	}

	# 一台机器上就一个后端，全都丢给它。
	reverse_proxy game:3000 {
		# 让服务端拿到真实来源。服务端已开 trustProxy，会认这些头。
		header_up X-Real-IP {remote_host}
	}
}

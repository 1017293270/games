# 复制为 deploy/.env 后按注释填写。.env 不进仓库（根 .gitignore 已忽略）。
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d
#
# 改完任何一项都要 `docker compose up -d` 让它生效（会重建对应容器）。

# ---------------------------------------------------------------- 域名与证书

# 你的域名。DNS 的 A 记录要先指到这台服务器的公网 IP，Caddy 才申请得到证书。
# 填好之后访问 https://你的域名 就能玩，证书自动续期，不用管。
#
# 没有域名时填 `:80`（连冒号一起）：只开 HTTP，用 http://服务器IP 访问。
# 注意：没有 HTTPS 就装不了 PWA（安卓「添加到主屏幕」会退化成普通书签）。
DOMAIN=xianxia.example.com

# 证书快到期时 Let's Encrypt 给谁发信。可以留空。
ACME_EMAIL=

# 宿主机上对外开放的端口。绝大多数情况不用改。
# 只有当这台机器上 80/443 已经被别的服务占了，才改成别的（比如 8080 / 8443）——
# 但改了 80 之后 Caddy 就申请不到证书了，那种情况请用「已有 nginx」的方案，
# 见 docs/DEPLOY.md 的常见问题。
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- 游戏服务端

# 后台密码。**必填**，留空的话容器起不来。
# 后台在 https://你的域名/admin，用它登录，可以调修炼倍率、发邀请码、管机器人。
# 请换成一串你自己的长密码。
ADMIN_PASSWORD=

# 后台用户名。
ADMIN_USERNAME=admin

# 首次启动时写入的一条「无限次」邀请码。世界设置里默认要求邀请码才能注册，
# 把这串发给朋友，他们注册时填进去即可。留空则不写入任何邀请码
# （那样第一个人也注册不了，得先去后台里发一张）。
INVITE_CODE=qingyun

# 登录后多少天内不用重新登录。
SESSION_TTL_DAYS=30

# 日志详细程度：fatal error warn info debug trace silent
LOG_LEVEL=info

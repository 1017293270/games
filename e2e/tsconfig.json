{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Playwright bundles the specs itself, so the bundler resolution (and no
    // emit) is the right model here — unlike the apps, which really are
    // compiled by tsc for Node.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["playwright.config.ts", "tests/**/*.ts"]
}
